# Copy to .env.test and point at a DISPOSABLE database - the test suite
# creates/reuses this schema and seeds real rows into it (roles, stages,
# an admin login, sample jobs/orders/documents). Never point this at your
# production or shared development database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trafo360_test
DB_USER=trafo360_test
DB_PASSWORD=trafo360_test

SESSION_SECRET=test_session_secret_do_not_use_in_prod
NODE_ENV=test

ADMIN_NAME=Test Admin
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=TestAdmin123!
