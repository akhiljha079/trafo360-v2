{
  "name": "@trafo360/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev --respawn --transpile-only -r dotenv/config src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@trafo360/shared": "*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
