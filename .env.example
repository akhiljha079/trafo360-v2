# Copy to .env and fill in real values. Never commit the real .env.

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://trafo360:CHANGE_ME@localhost:5432/trafo360?schema=public"

# --- App -------------------------------------------------------------------
NODE_ENV=production
APP_URL="https://document.company.com"
API_PORT=4000
# How the worker process reaches the API to trigger scheduled checks (e.g.
# type test certificate expiry reminders) - it has no logged-in user of its
# own, so this is a plain HTTP call, not a browser request. Under Docker
# Compose this must be the api service's container-network name
# (http://api:4000), NOT localhost - the worker and api run in separate
# containers, so "localhost" would mean the worker container itself.
API_INTERNAL_URL="http://localhost:4000"

# --- Auth secrets (generate with `openssl rand -hex 32`) -------------------
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
# 32-byte key used to encrypt secrets-at-rest (AD bind password, SMTP password)
# stored in the system_setting table. Generate with `openssl rand -hex 32`.
SECRETS_ENCRYPTION_KEY="CHANGE_ME"
SESSION_COOKIE_NAME="trafo360_session"
# Shared secret the worker process sends to trigger the type test certificate
# expiry check (apps/worker calls apps/api - not a real user session).
# Generate with `openssl rand -hex 32`.
INTERNAL_WORKER_TOKEN="CHANGE_ME"

# --- Bootstrap local administrator (see docs/architecture.md - documented
# exception to "AD is the only auth method", used only for initial setup) --
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@company.com"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME_BEFORE_FIRST_DEPLOY"

# --- AD / LDAP (all of this is also editable from Administration -> AD/LDAP
# once the bootstrap admin is logged in; these env vars only seed defaults) -
AD_HOST=""
AD_PORT="636"
AD_PROTOCOL="ldaps"
AD_BASE_DN=""
AD_USER_SEARCH_DN=""
AD_BIND_USER=""
AD_BIND_PASSWORD=""
AD_USER_SEARCH_FILTER="(sAMAccountName={{username}})"
AD_DOMAIN=""
AD_CONNECT_TIMEOUT_MS="5000"

# --- SMTP (also editable from Administration -> SMTP Settings) -------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@company.com"
SMTP_FROM_NAME="TRAFO 360"

# --- Storage (spec §36/§37) --------------------------------------------------
NFS_MOUNT_PATH="/mnt/company-document-storage"
LOCAL_STORAGE_PATH="/var/trafo360/local-storage"

# --- WhatsApp Web (spec §35) - session persisted here, never in the DB -----
WHATSAPP_SESSION_PATH="/var/trafo360/whatsapp-session"
