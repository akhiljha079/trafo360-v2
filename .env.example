# ==============================================
# Trafo Power & Electricals - Workflow & DMS
# Environment Configuration
# Copy this file to .env and fill in real values.
# ==============================================

# Application
APP_NAME=TRAFO 360
APP_URL=https://your-domain-or-ip:PORT
PORT=3000
NODE_ENV=production
SESSION_SECRET=change_this_to_a_long_random_string
# Sessions are stored in MySQL (a `sessions` table is auto-created on first
# boot) - no separate session-store config needed.
LOG_LEVEL=info

# MySQL Database (create via aaPanel > Database, or via docker-compose)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trafo_dms
DB_USER=trafo_dms_user
DB_PASSWORD=change_this_password
# Only used by docker-compose.yml, to set the MySQL container's root password.
DB_ROOT_PASSWORD=change_this_root_password

# Default SMTP (used until Admin configures SMTP from the app's Admin > SMTP Settings page)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=notifications@trafopower.com
SMTP_FROM_NAME=Trafo Power & Electricals - Workflow System

# Default Admin (used by `npm run create-admin`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@trafopower.com
ADMIN_PASSWORD=change_this_password

# Document issue policy
DEFAULT_ISSUE_DAYS=7
GRACE_PERIOD_WORKING_DAYS=2
# Days considered "working" (Mon-Sat, Sunday off) - comma separated, 0=Sun..6=Sat
WORKING_DAYS=1,2,3,4,5,6

# File upload
MAX_UPLOAD_MB=25

# WhatsApp Web (unofficial, optional) - only needed if you enable it from Admin > WhatsApp Notifications.
# If your server doesn't have a system Chromium, leave this unset and Puppeteer will try to
# download its own on first `npm install` (requires outbound internet access).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
