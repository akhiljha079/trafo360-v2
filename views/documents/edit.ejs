<h4 class="mb-3">Edit <%= doc.doc_code %></h4>
<div class="card" style="max-width:700px;">
  <div class="card-body">
    <form action="/documents/<%= doc.id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Document Code</label>
          <input type="text" class="form-control" value="<%= doc.doc_code %>" disabled>
          <div class="form-text">Document Code cannot be changed after creation.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Document Name *</label>
          <input type="text" name="doc_name" class="form-control" required value="<%= doc.doc_name %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <select name="category_id" class="form-select">
            <option value="">-- Select --</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= c.id===doc.category_id ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Confidentiality *</label>
          <select name="confidentiality" class="form-select" required>
            <% ['Public','Internal','Confidential','Highly Confidential'].forEach(function(c) { %>
              <option value="<%= c %>" <%= doc.confidentiality===c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Linked Transformer Job</label>
          <select name="related_job_id" class="form-select">
            <option value="">-- None --</option>
            <% jobs.forEach(function(j) { %>
              <option value="<%= j.id %>" <%= j.id===doc.related_job_id ? 'selected' : '' %>><%= j.job_no %> - <%= j.customer_name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Physical Storage Location</label>
          <input type="text" name="storage_location" class="form-control" value="<%= doc.storage_location || '' %>">
        </div>
        <div class="col-md-12">
          <label class="form-label">Replace Scanned Copy (optional)</label>
          <input type="file" name="file" class="form-control">
          <div class="form-text">Leave blank to keep the currently uploaded file. Replacing it re-runs OCR on the new file.</div>
        </div>
        <div class="col-md-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="customer_visible" id="customer_visible" value="1" <%= doc.customer_visible ? 'checked' : '' %>>
            <label class="form-check-label" for="customer_visible">Visible in the Customer Portal (only if this document's linked job/order belongs to a portal customer)</label>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/documents/<%= doc.id %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
