<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0">Document Library <% if (showArchived) { %><span class="badge bg-secondary">Archived</span><% } %></h4>
  <div class="d-flex gap-2">
    <a href="/documents<%= showArchived ? '' : '?view=archived' %>" class="btn btn-outline-secondary btn-sm">
      <% if (showArchived) { %><i class="bi bi-arrow-left"></i> Back to Active<% } else { %><i class="bi bi-archive"></i> View Archived<% } %>
    </a>
    <% if (currentUser.can_manage_documents && !showArchived) { %>
      <a href="/documents/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Document</a>
    <% } %>
  </div>
</div>

<form class="row g-2 mb-3" method="GET">
  <% if (showArchived) { %><input type="hidden" name="view" value="archived"><% } %>
  <div class="col-md-4">
    <input type="text" name="q" class="form-control" placeholder="Search Doc Code / Name" value="<%= filters.q || '' %>">
  </div>
  <div class="col-md-3">
    <select name="category_id" class="form-select">
      <option value="">All Categories</option>
      <% categories.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= String(filters.category_id)===String(c.id)?'selected':'' %>><%= c.name %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-md-3">
    <select name="confidentiality" class="form-select">
      <option value="">All Confidentiality Levels</option>
      <option value="Public" <%= filters.confidentiality==='Public'?'selected':'' %>>Public</option>
      <option value="Internal" <%= filters.confidentiality==='Internal'?'selected':'' %>>Internal</option>
      <option value="Confidential" <%= filters.confidentiality==='Confidential'?'selected':'' %>>Confidential</option>
      <option value="Highly Confidential" <%= filters.confidentiality==='Highly Confidential'?'selected':'' %>>Highly Confidential</option>
    </select>
  </div>
  <div class="col-md-2">
    <button class="btn btn-outline-secondary w-100" type="submit">Filter</button>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Doc Code</th><th>Name</th><th>Category</th><th>Confidentiality</th><th>Linked Job</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% documents.forEach(function(d) { %>
        <tr>
          <td><%= d.doc_code %></td>
          <td><%= d.doc_name %></td>
          <td><%= d.category_name || '-' %></td>
          <td>
            <% var confBadge = d.confidentiality === 'Public' ? 'bg-success' : d.confidentiality === 'Internal' ? 'bg-primary' : d.confidentiality === 'Confidential' ? 'bg-warning text-dark' : 'bg-danger'; %>
            <span class="badge <%= confBadge %>"><%= d.confidentiality %></span>
          </td>
          <td><%= d.job_no || '-' %></td>
          <td><span class="badge bg-secondary"><%= d.current_status %></span></td>
          <td class="text-nowrap">
            <a href="/documents/<%= d.id %>" class="btn btn-sm btn-outline-primary">View</a>
            <% if (currentUser.can_manage_documents) { %>
              <% if (showArchived) { %>
                <form action="/documents/<%= d.id %>/restore" method="POST" class="d-inline">
                  <button class="btn btn-sm btn-outline-success" type="submit">Restore</button>
                </form>
              <% } else { %>
                <a href="/documents/<%= d.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                <form action="/documents/<%= d.id %>/archive" method="POST" class="d-inline" onsubmit="return confirm('Archive this document? It can be restored later.')">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                </form>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (documents.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No documents found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
