<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>QR Label - <%= doc.doc_code %></title>
  <style>
    @page { size: 90mm 50mm; margin: 3mm; }
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
    .label {
      width: 84mm; height: 44mm; box-sizing: border-box; border: 1px dashed #999;
      padding: 3mm; display: flex; align-items: center; gap: 4mm;
    }
    .label img { width: 32mm; height: 32mm; flex-shrink: 0; }
    .label .info { flex-grow: 1; overflow: hidden; }
    .label .company { font-size: 9px; font-weight: bold; color: #1F4E78; text-transform: uppercase; }
    .label .code { font-size: 16px; font-weight: 800; color: #111; margin: 2px 0; }
    .label .name { font-size: 10px; color: #333; line-height: 1.3; max-height: 26px; overflow: hidden; }
    .label .conf { font-size: 9px; font-weight: bold; margin-top: 3px; display: inline-block; padding: 1px 6px; border-radius: 3px; }
    .no-print { margin: 20px; font-family: Arial, sans-serif; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <div class="no-print">
    <p><b>Print Preview</b> — use your browser's Print (Ctrl/Cmd+P) and select a label/sticker printer, or print on A4 and cut out.</p>
    <button onclick="window.print()">Print This Label</button>
  </div>

  <div class="label">
    <img src="/documents/<%= doc.id %>/qrcode.png" alt="QR Code">
    <div class="info">
      <div class="company">Trafo Power & Electricals Pvt Ltd</div>
      <div class="code"><%= doc.doc_code %></div>
      <div class="name"><%= doc.doc_name %></div>
      <span class="conf" style="background:#D9E2F3;color:#1F4E78;"><%= doc.confidentiality %></span>
    </div>
  </div>
</body>
</html>
