<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0"><%= doc.doc_code %></h4>
    <div class="text-muted"><%= doc.doc_name %></div>
  </div>
  <div class="text-end">
    <% var confBadge = doc.confidentiality === 'Public' ? 'bg-success' : doc.confidentiality === 'Internal' ? 'bg-primary' : doc.confidentiality === 'Confidential' ? 'bg-warning text-dark' : 'bg-danger'; %>
    <span class="badge <%= confBadge %> fs-6 mb-2"><%= doc.confidentiality %></span><br>
    <% if (currentUser.can_manage_documents) { %>
      <a href="/documents/<%= doc.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
      <% if (doc.is_active) { %>
        <form action="/documents/<%= doc.id %>/archive" method="POST" class="d-inline" onsubmit="return confirm('Archive this document?')">
          <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Archive</button>
        </form>
      <% } else { %>
        <form action="/documents/<%= doc.id %>/restore" method="POST" class="d-inline">
          <button class="btn btn-sm btn-outline-success" type="submit">Restore</button>
        </form>
      <% } %>
    <% } %>
    <% if (currentUser.is_admin) { %>
      <form action="/documents/<%= doc.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Permanently delete this document and its file? This CANNOT be undone.')">
        <button class="btn btn-sm btn-outline-danger" type="submit" title="Permanent delete"><i class="bi bi-x-octagon"></i></button>
      </form>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header">Details</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><th style="width:200px;">Category</th><td><%= doc.category_name || '-' %></td></tr>
          <tr><th>Linked Job</th><td><%= doc.job_no ? doc.job_no + ' - ' + doc.customer_name : '-' %></td></tr>
          <% if (doc.related_order_no) { %>
            <tr><th>Linked Order</th><td><a href="/orders/<%= doc.related_order_id %>"><%= doc.related_order_no %></a><% if (doc.related_lot_name) { %> / <%= doc.related_lot_name || ('Lot ' + doc.related_lot_no) %><% } %></td></tr>
          <% } %>
          <tr><th>Storage Location</th><td><%= doc.storage_location || '-' %></td></tr>
          <tr><th>Current Status</th><td><span class="badge bg-secondary"><%= doc.current_status %></span></td></tr>
          <tr><th>Uploaded By</th><td><%= doc.uploaded_by_name || '-' %> on <%= doc.upload_date %></td></tr>
        </table>
        <% if (doc.file_path) { %>
          <a href="/documents/<%= doc.id %>/download" class="btn btn-outline-primary btn-sm mt-2"><i class="bi bi-download"></i> Download Scanned Copy</a>
        <% } %>
      </div>
    </div>

    <% if (doc.current_status === 'Available') { %>
    <div class="card">
      <div class="card-body">
        <a href="/issues/new?document_id=<%= doc.id %>" class="btn btn-primary"><i class="bi bi-box-arrow-right"></i> Request to Issue This Document</a>
      </div>
    </div>
    <% } %>
  </div>

  <div class="col-lg-5">
    <div class="card mb-3">
      <div class="card-header">Physical File QR Tracking</div>
      <div class="card-body text-center">
        <img src="/documents/<%= doc.id %>/qrcode.png" alt="QR Code" style="width:160px;height:160px;">
        <p class="text-muted small mt-2 mb-2">Print this QR code and stick it on the physical file/folder. Scanning it with any phone camera opens this page directly (after login).</p>
        <a href="/documents/<%= doc.id %>/label" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer"></i> Print Label</a>
        <% if (currentUser.can_manage_documents) { %>
        <form action="/documents/<%= doc.id %>/qrcode/regenerate" method="POST" class="d-inline" onsubmit="return confirm('This invalidates the old printed label. Continue?')">
          <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-repeat"></i> Regenerate</button>
        </form>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">Issue History</div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Requested By</th><th>Status</th><th>Due</th></tr></thead>
          <tbody>
          <% issueHistory.forEach(function(h) { %>
            <tr>
              <td><%= h.requester_name %></td>
              <td><span class="badge status-badge-<%= h.status.replace(/ /g,'') %>"><%= h.status %></span></td>
              <td><%= h.due_date || '-' %></td>
            </tr>
          <% }); %>
          <% if (issueHistory.length === 0) { %><tr><td colspan="3" class="text-center text-muted py-3">No issue history.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
