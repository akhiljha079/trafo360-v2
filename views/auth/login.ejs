<div class="login-wrapper">
  <div class="login-visual d-none d-md-flex">
    <span class="badge-est">ISO 9001:2015 Certified &middot; Established 1986</span>
    <h1>Power &amp; Distribution<br>Transformer Manufacturing,<br>Tracked End to End.</h1>
    <p>From enquiry to dispatch, <%= typeof appName !== 'undefined' ? appName : 'TRAFO 360' %> gives Trafo Power &amp; Electricals Pvt. Ltd. a single system for the Sales &rarr; Manufacturing &rarr; Dispatch workflow and the document library that supports it.</p>
    <div class="stat-row">
      <div><div class="num">1986</div><div class="lbl">Est. Since</div></div>
      <div><div class="num">50,000</div><div class="lbl">kVA Capacity</div></div>
      <div><div class="num">132kV</div><div class="lbl">Max Voltage Class</div></div>
    </div>
  </div>

  <div class="login-form-side">
    <div class="login-card">
      <div class="text-center mb-3">
        <div class="login-title"><%= typeof appName !== 'undefined' ? appName : 'TRAFO 360' %></div>
        <div class="text-muted small">Workflow &amp; Document Management &mdash; Trafo Power &amp; Electricals Pvt. Ltd.</div>
      </div>
      <% if (typeof success !== 'undefined' && success.length) { %>
        <% success.forEach(function(m) { %><div class="alert alert-success py-2"><%= m %></div><% }); %>
      <% } %>
      <% if (typeof error !== 'undefined' && error.length) { %>
        <% error.forEach(function(m) { %><div class="alert alert-danger py-2"><%= m %></div><% }); %>
      <% } %>
      <form action="/login" method="POST">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
        <div class="mb-3">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-box-arrow-in-right"></i> Login
        </button>
      </form>
      <div class="text-center text-muted mt-4" style="font-size:11px;">
        Built by <a href="https://vayrone.com" target="_blank" rel="noopener" style="color:#1E7FD1;text-decoration:none;font-weight:600;">Vayrone Infratech</a>
      </div>
    </div>
  </div>
</div>
