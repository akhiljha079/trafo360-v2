<div class="card mb-3">
  <div class="card-header">Active Jobs by Phase</div>
  <div class="card-body">
    <% if (jobsByPhase.length === 0) { %>
      <p class="text-muted mb-0">No active jobs.</p>
    <% } %>
    <% jobsByPhase.forEach(function(p) { %>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge badge-phase-<%= p.phase %>"><%= p.phase %></span>
        <span class="fw-bold"><%= p.cnt %> job(s)</span>
      </div>
    <% }); %>
  </div>
</div>
