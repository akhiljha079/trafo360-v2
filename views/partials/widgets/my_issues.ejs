<div class="card mb-3">
  <div class="card-header">My Issued Documents (Due Soon)</div>
  <div class="card-body">
    <% if (myIssues.length === 0) { %><p class="text-muted mb-0">Nothing currently issued to you.</p><% } %>
    <% myIssues.forEach(function(m) { %>
      <div class="d-flex justify-content-between border-bottom py-2">
        <div>
          <div class="fw-bold"><%= m.doc_code %></div>
          <div class="small text-muted"><%= m.doc_name %></div>
        </div>
        <div class="text-end">
          <span class="badge status-badge-<%= m.status.replace(/ /g,'') %>"><%= m.status %></span>
          <div class="small text-muted">Due: <%= m.due_date %></div>
        </div>
      </div>
    <% }); %>
  </div>
</div>
