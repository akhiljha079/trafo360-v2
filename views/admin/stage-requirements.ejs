<h4 class="mb-3">Stage Document Requirements</h4>
<p class="text-muted small">Define what a department must upload before a unit is allowed to move past a given stage. Mandatory requirements block "Advance to next stage" on the job page until satisfied.</p>

<div class="card mb-4" data-animate>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead><tr><th>Stage</th><th>Requirement</th><th>Mandatory</th><th>Active</th><th></th></tr></thead>
      <tbody>
      <% requirements.forEach(function(r) { %>
        <tr>
          <td><span class="badge badge-phase-<%= r.phase %>"><%= r.stage_name %></span></td>
          <td><%= r.requirement_name %></td>
          <td><% if (r.is_mandatory) { %><span class="badge bg-danger">Mandatory</span><% } else { %><span class="badge bg-secondary">Optional</span><% } %></td>
          <td>
            <form action="/admin/stage-requirements/<%= r.id %>/toggle" method="POST">
              <button class="btn btn-sm <%= r.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
                <%= r.is_active ? 'Active' : 'Inactive' %>
              </button>
            </form>
          </td>
          <td>
            <form action="/admin/stage-requirements/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Remove this requirement?')">
              <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (requirements.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-3">No requirements configured - stages can be advanced freely.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card" style="max-width:600px;" data-animate>
  <div class="card-header">Add Requirement</div>
  <div class="card-body">
    <form action="/admin/stage-requirements" method="POST" class="row g-2">
      <div class="col-md-12">
        <label class="form-label small">Stage</label>
        <select name="stage_id" class="form-select" required>
          <% stages.forEach(function(s) { %><option value="<%= s.id %>"><%= s.phase %> - <%= s.stage_code %> - <%= s.stage_name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label small">Requirement Name</label>
        <input type="text" name="requirement_name" class="form-control" placeholder="e.g. Core Cutting Inspection Report" required>
      </div>
      <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="is_mandatory" id="isMandatory" checked>
          <label class="form-check-label" for="isMandatory">Mandatory</label>
        </div>
      </div>
      <div class="col-12"><button class="btn btn-primary" type="submit">Add Requirement</button></div>
    </form>
  </div>
</div>
