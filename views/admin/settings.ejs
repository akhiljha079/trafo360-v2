<h4 class="mb-3">System Settings</h4>

<div class="card" style="max-width:600px;">
  <div class="card-body">
    <form action="/admin/settings" method="POST">
      <div class="mb-3">
        <label class="form-label">Application Name</label>
        <input type="text" name="app_name" class="form-control" value="<%= settings.app_name || 'TRAFO 360' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Company Name</label>
        <input type="text" name="company_name" class="form-control" value="<%= settings.company_name || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Company Tagline</label>
        <input type="text" name="company_tagline" class="form-control" value="<%= settings.company_tagline || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Default Document Issue Period (days)</label>
        <input type="number" name="default_issue_days" class="form-control" value="<%= settings.default_issue_days || 7 %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Grace Period Before Escalation (working days)</label>
        <input type="number" name="grace_period_working_days" class="form-control" value="<%= settings.grace_period_working_days || 2 %>">
        <div class="form-text">If a document is not returned or extended within this many working days after the due date, an automatic escalation email is sent to the Director.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Reminder: Days Before Due Date</label>
        <input type="number" name="reminder_days_before_due" class="form-control" value="<%= settings.reminder_days_before_due || 1 %>">
      </div>
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
  </div>
</div>
