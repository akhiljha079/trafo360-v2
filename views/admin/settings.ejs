<h4 class="mb-3">System Settings</h4>

<div class="card" style="max-width:600px;" data-animate>
  <div class="card-body">
    <form action="/admin/settings" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Application Name</label>
        <input type="text" name="app_name" class="form-control" value="<%= settings.app_name || 'TRAFO 360' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Company Name</label>
        <input type="text" name="company_name" class="form-control" value="<%= settings.company_name || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Company Tagline</label>
        <input type="text" name="company_tagline" class="form-control" value="<%= settings.company_tagline || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Company Logo</label>
        <% if (settings.company_logo_path) { %>
          <div class="mb-2"><img src="<%= settings.company_logo_path %>" alt="Current logo" style="max-height:50px;max-width:220px;"></div>
        <% } %>
        <input type="file" name="logo" class="form-control" accept="image/*">
        <div class="form-text">Shown on the letterhead of every generated technical document (Documents &rarr; Generate Document).</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Default Document Issue Period (days)</label>
        <input type="number" name="default_issue_days" class="form-control" value="<%= settings.default_issue_days || 7 %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Grace Period Before Escalation (working days)</label>
        <input type="number" name="grace_period_working_days" class="form-control" value="<%= settings.grace_period_working_days || 2 %>">
        <div class="form-text">If a document is not returned or extended within this many working days after the due date, an automatic escalation email is sent to the Director.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Reminder: Days Before Due Date</label>
        <input type="number" name="reminder_days_before_due" class="form-control" value="<%= settings.reminder_days_before_due || 1 %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Default Warranty Period (months)</label>
        <input type="number" name="default_warranty_months" class="form-control" value="<%= settings.default_warranty_months || 18 %>">
        <div class="form-text">Used when a transformer type has no warranty period of its own set in Admin &rarr; GTP Schema.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Warranty Expiring Alert (days before expiry)</label>
        <input type="number" name="warranty_expiring_days_before" class="form-control" value="<%= settings.warranty_expiring_days_before || 60 %>">
        <div class="form-text">A warranty moves from Active to Expiring this many days before its end date, and the Warranty module's users are notified.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Warranty Certificate Terms</label>
        <textarea name="warranty_terms_text" class="form-control" rows="4"><%= settings.warranty_terms_text || '' %></textarea>
        <div class="form-text">Shown on every generated Warranty Certificate (Documents &rarr; Generate Document).</div>
      </div>
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
  </div>
</div>
