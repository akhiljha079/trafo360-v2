<h4 class="mb-3">SMTP Settings</h4>
<p class="text-muted">Configure the mail server used to send all automated emails (stage notifications, document approval requests, reminders, escalations). Changes here take effect immediately without a redeploy.</p>

<div class="card" style="max-width:600px;">
  <div class="card-body">
    <form action="/admin/smtp" method="POST">
      <div class="mb-3">
        <label class="form-label">SMTP Host</label>
        <input type="text" name="host" class="form-control" value="<%= smtp ? smtp.host : '' %>" placeholder="smtp.gmail.com" required>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Port</label>
          <input type="number" name="port" class="form-control" value="<%= smtp ? smtp.port : 587 %>" required>
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="secure" id="secure" <%= smtp && smtp.secure ? 'checked' : '' %>>
            <label class="form-check-label" for="secure">Use SSL/TLS (secure)</label>
          </div>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">SMTP Username</label>
        <input type="text" name="username" class="form-control" value="<%= smtp ? smtp.username : '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">SMTP Password / App Password</label>
        <input type="password" name="password" class="form-control" value="<%= smtp ? smtp.password : '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">From Email</label>
        <input type="email" name="from_email" class="form-control" value="<%= smtp ? smtp.from_email : '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">From Name</label>
        <input type="text" name="from_name" class="form-control" value="<%= smtp ? smtp.from_name : 'TRAFO 360 - Trafo Power & Electricals' %>" required>
      </div>
      <button type="submit" class="btn btn-primary">Save SMTP Settings</button>
    </form>
  </div>
</div>
