<h4 class="mb-3">Manage Roles & Privileges</h4>
<p class="text-muted">Each role has three core flags plus a per-module View/Create/Edit/Delete/Approve grid. Changes take effect the next time a user with that role logs in.</p>

<div class="accordion mb-4" id="rolesAccordion">
  <% roles.forEach(function(r, idx) { %>
    <% const perms = permMap[r.id] || {}; %>
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button <%= idx === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#role-<%= r.id %>">
          <strong><%= r.name %></strong>
          <% if (r.is_admin) { %><span class="badge bg-primary ms-2">Admin</span><% } %>
          <% if (r.is_director) { %><span class="badge bg-warning text-dark ms-2">Director</span><% } %>
          <% if (r.description) { %><span class="text-muted small ms-2"><%= r.description %></span><% } %>
        </button>
      </h2>
      <div id="role-<%= r.id %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" data-bs-parent="#rolesAccordion">
        <div class="accordion-body">
          <form action="/admin/roles/<%= r.id %>" method="POST">
            <div class="d-flex flex-wrap gap-4 mb-3 p-2 rounded" style="background: var(--tp-blue-light);">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="is_admin" id="is_admin-<%= r.id %>" <%= r.is_admin ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold" for="is_admin-<%= r.id %>">Admin (full system access, bypasses all module checks)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="is_director" id="is_director-<%= r.id %>" <%= r.is_director ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold" for="is_director-<%= r.id %>">Director (receives escalation emails)</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="can_view_confidential" id="can_view_confidential-<%= r.id %>" <%= r.can_view_confidential ? 'checked' : '' %>>
                <label class="form-check-label fw-semibold" for="can_view_confidential-<%= r.id %>">View Confidential documents</label>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-sm align-middle mb-3">
                <thead>
                  <tr>
                    <th>Module</th>
                    <th class="text-center">View</th>
                    <th class="text-center">Create</th>
                    <th class="text-center">Edit</th>
                    <th class="text-center">Delete</th>
                    <th class="text-center">Approve</th>
                  </tr>
                </thead>
                <tbody>
                <% modules.forEach(function(m) { %>
                  <% const p = perms[m.id] || {}; %>
                  <tr>
                    <td><i class="bi <%= m.icon || 'bi-app' %> me-1"></i><%= m.name %></td>
                    <td class="text-center"><input type="checkbox" name="perm[<%= m.id %>][view]" <%= p.can_view ? 'checked' : '' %>></td>
                    <td class="text-center"><input type="checkbox" name="perm[<%= m.id %>][create]" <%= p.can_create ? 'checked' : '' %>></td>
                    <td class="text-center"><input type="checkbox" name="perm[<%= m.id %>][edit]" <%= p.can_edit ? 'checked' : '' %>></td>
                    <td class="text-center"><input type="checkbox" name="perm[<%= m.id %>][delete]" <%= p.can_delete ? 'checked' : '' %>></td>
                    <td class="text-center"><input type="checkbox" name="perm[<%= m.id %>][approve]" <%= p.can_approve ? 'checked' : '' %>></td>
                  </tr>
                <% }); %>
                </tbody>
              </table>
            </div>
            <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-check2"></i> Save <%= r.name %></button>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div class="card" style="max-width:500px;">
  <div class="card-header">Add New Role</div>
  <div class="card-body">
    <form action="/admin/roles" method="POST" class="row g-2">
      <div class="col-md-6"><input type="text" name="name" class="form-control" placeholder="Role name" required></div>
      <div class="col-md-6"><input type="text" name="description" class="form-control" placeholder="Description"></div>
      <div class="col-12"><button class="btn btn-primary" type="submit">Add Role</button></div>
    </form>
  </div>
</div>
