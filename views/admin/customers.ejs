<h4 class="mb-1">Customer Portal</h4>
<p class="text-muted small mb-3">Manage the customer accounts that can log in to the Customer Portal (a separate login from staff, at <code>/portal/login</code>). Link a customer to an order from that order's Edit / GTP page. A customer only ever sees their own orders and documents an admin has marked <b>Customer Visible</b>.</p>

<div class="card mb-4" style="max-width:600px;" data-animate>
  <div class="card-header">Add Customer</div>
  <div class="card-body">
    <form action="/admin/customers" method="POST" class="row g-2">
      <div class="col-md-5"><input type="text" name="name" class="form-control" placeholder="Customer / company name" required></div>
      <div class="col-md-4"><input type="email" name="contact_email" class="form-control" placeholder="Contact email"></div>
      <div class="col-md-3"><input type="text" name="contact_phone" class="form-control" placeholder="Contact phone"></div>
      <div class="col-12"><button class="btn btn-primary" type="submit">Add Customer</button></div>
    </form>
  </div>
</div>

<div class="accordion" id="customersAccordion">
  <% customers.forEach(function(c, idx) { %>
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#customer-<%= c.id %>">
          <strong><%= c.name %></strong>
          <span class="badge bg-secondary ms-2"><%= c.order_count %> order(s)</span>
          <span class="badge <%= c.is_active ? 'bg-success' : 'bg-secondary' %> ms-2"><%= c.is_active ? 'Active' : 'Disabled' %></span>
          <span class="text-muted small ms-2"><%= c.users.length %> portal login(s)</span>
        </button>
      </h2>
      <div id="customer-<%= c.id %>" class="accordion-collapse collapse" data-bs-parent="#customersAccordion">
        <div class="accordion-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="small text-muted"><%= c.contact_email || '-' %> &middot; <%= c.contact_phone || '-' %></div>
            <form action="/admin/customers/<%= c.id %>/toggle" method="POST">
              <button class="btn btn-sm <%= c.is_active ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit">
                <%= c.is_active ? 'Disable Customer' : 'Enable Customer' %>
              </button>
            </form>
          </div>

          <table class="table table-sm align-middle">
            <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Reset Password</th></tr></thead>
            <tbody>
            <% c.users.forEach(function(u) { %>
              <tr>
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td>
                  <form action="/admin/customers/<%= c.id %>/users/<%= u.id %>/toggle" method="POST">
                    <button class="btn btn-sm <%= u.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit"><%= u.is_active ? 'Active' : 'Inactive' %></button>
                  </form>
                </td>
                <td>
                  <form action="/admin/customers/<%= c.id %>/users/<%= u.id %>/reset-password" method="POST" class="d-flex gap-1">
                    <input type="password" name="new_password" class="form-control form-control-sm" placeholder="New password" style="width:140px;" required>
                    <button class="btn btn-sm btn-outline-warning" type="submit">Reset</button>
                  </form>
                </td>
              </tr>
            <% }); %>
            <% if (c.users.length === 0) { %><tr><td colspan="4" class="text-muted small">No portal logins yet.</td></tr><% } %>
            </tbody>
          </table>

          <form action="/admin/customers/<%= c.id %>/users" method="POST" class="row g-2">
            <div class="col-md-4"><input type="text" name="name" class="form-control form-control-sm" placeholder="Login name" required></div>
            <div class="col-md-4"><input type="email" name="email" class="form-control form-control-sm" placeholder="Email" required></div>
            <div class="col-md-3"><input type="password" name="password" class="form-control form-control-sm" placeholder="Password" required></div>
            <div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit">Add</button></div>
          </form>
        </div>
      </div>
    </div>
  <% }); %>
  <% if (customers.length === 0) { %><p class="text-muted text-center py-4">No customers yet - add one above.</p><% } %>
</div>
