<h4 class="mb-1">GTP Schema</h4>
<p class="text-muted">This is the source of truth for the GTP (General Technical Particulars) form shown when creating/editing an Order, the department work orders, and (once generated) technical documents. Add, edit, reorder, or disable transformer types, field groups, and fields — every Order form automatically follows whatever is defined here, per transformer type.</p>

<ul class="nav tabs-modern mb-3" role="tablist">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-types" type="button"><i class="bi bi-diagram-2"></i> Transformer Types</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fields" type="button"><i class="bi bi-list-columns"></i> Field Groups &amp; Fields</button></li>
</ul>

<div class="tab-content">
<div class="tab-pane fade show active" id="tab-types">

<div class="card mb-4">
  <div class="card-header">Transformer Types</div>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>#</th><th>Name</th><th>Warranty (months)</th><th>Active</th></tr></thead>
      <tbody>
      <% transformerTypes.forEach(function(t) { %>
        <tr>
          <td><%= t.sequence_order %></td>
          <td><b><%= t.name %></b></td>
          <td style="width:180px;">
            <form action="/admin/gtp-schema/types/<%= t.id %>/warranty-months" method="POST" class="d-flex gap-1">
              <input type="number" name="warranty_months" class="form-control form-control-sm" value="<%= t.warranty_months %>" min="1" max="240" style="width:80px;">
              <button class="btn btn-sm btn-outline-secondary" type="submit">Save</button>
            </form>
          </td>
          <td>
            <form action="/admin/gtp-schema/types/<%= t.id %>/toggle" method="POST">
              <button class="btn btn-sm <%= t.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
                <%= t.is_active ? 'Enabled' : 'Disabled' %>
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
  <div class="card-body">
    <form action="/admin/gtp-schema/types" method="POST" class="row g-2">
      <div class="col-md-4"><input type="text" name="name" class="form-control" placeholder="e.g. Rectifier Transformer" required></div>
      <div class="col-md-2"><input type="number" name="sequence_order" class="form-control" placeholder="Order #"></div>
      <div class="col-md-2"><input type="number" name="warranty_months" class="form-control" placeholder="Warranty (months)" value="18"></div>
      <div class="col-md-2"><button class="btn btn-primary" type="submit">Add Type</button></div>
    </form>
  </div>
</div>

</div>

<div class="tab-pane fade" id="tab-fields">

<% groups.forEach(function(g) { %>
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <b><%= g.name %></b>
        <span class="badge bg-light text-dark ms-1"><%= g.transformer_type_name || 'All Types' %></span>
      </div>
      <div class="d-flex gap-1">
        <form action="/admin/gtp-schema/groups/<%= g.id %>/reorder" method="POST" class="d-inline">
          <input type="hidden" name="direction" value="up">
          <button class="btn btn-sm btn-light" type="submit" title="Move Up"><i class="bi bi-arrow-up"></i></button>
        </form>
        <form action="/admin/gtp-schema/groups/<%= g.id %>/reorder" method="POST" class="d-inline">
          <input type="hidden" name="direction" value="down">
          <button class="btn btn-sm btn-light" type="submit" title="Move Down"><i class="bi bi-arrow-down"></i></button>
        </form>
        <form action="/admin/gtp-schema/groups/<%= g.id %>/toggle" method="POST" class="d-inline">
          <button class="btn btn-sm <%= g.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
            <%= g.is_active ? 'Enabled' : 'Disabled' %>
          </button>
        </form>
        <form action="/admin/gtp-schema/groups/<%= g.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this group and all its fields? This cannot be undone.');">
          <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
        </form>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Key</th><th>Label</th><th>Unit</th><th>Type</th><th>Options</th><th>Stages</th><th>Active</th><th>Reorder</th><th></th></tr></thead>
        <tbody>
        <% g.fields.forEach(function(f) { %>
          <tr>
            <td><code><%= f.field_key %></code></td>
            <td>
              <form action="/admin/gtp-schema/fields/<%= f.id %>" method="POST" class="d-flex gap-1 flex-wrap align-items-center">
                <input type="text" name="label" class="form-control form-control-sm" value="<%= f.label %>" style="width:180px;">
                <input type="text" name="unit" class="form-control form-control-sm" value="<%= f.unit || '' %>" placeholder="Unit" style="width:80px;">
                <select name="field_type" class="form-select form-select-sm" style="width:110px;">
                  <% FIELD_TYPES.forEach(function(ft) { %>
                    <option value="<%= ft %>" <%= f.field_type===ft?'selected':'' %>><%= ft %></option>
                  <% }); %>
                </select>
                <input type="text" name="select_options" class="form-control form-control-sm" value="<%= f.select_options || '' %>" placeholder="opt1,opt2 (if select)" style="width:150px;">
                <select name="stage_codes" class="form-select form-select-sm" multiple style="width:140px;" size="1" title="Which stages/work-orders show this field">
                  <% var current = (f.stage_codes || '').split(',').map(function(s){return s.trim();}); %>
                  <% stages.forEach(function(s) { %>
                    <option value="<%= s.stage_code %>" <%= current.includes(s.stage_code) ? 'selected' : '' %>><%= s.stage_code %> - <%= s.stage_name %></option>
                  <% }); %>
                </select>
                <input type="number" name="sequence_order" class="form-control form-control-sm" value="<%= f.sequence_order %>" style="width:60px;">
                <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
              </form>
            </td>
            <td class="small text-muted"><%= f.unit || '-' %></td>
            <td class="small"><%= f.field_type %></td>
            <td class="small text-muted"><%= f.select_options || '-' %></td>
            <td class="small text-muted"><%= f.stage_codes || '-' %></td>
            <td>
              <form action="/admin/gtp-schema/fields/<%= f.id %>/toggle" method="POST">
                <button class="btn btn-sm <%= f.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
                  <%= f.is_active ? 'On' : 'Off' %>
                </button>
              </form>
            </td>
            <td>
              <form action="/admin/gtp-schema/fields/<%= f.id %>/reorder" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button class="btn btn-sm btn-light" type="submit" title="Move Up"><i class="bi bi-arrow-up"></i></button>
              </form>
              <form action="/admin/gtp-schema/fields/<%= f.id %>/reorder" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button class="btn btn-sm btn-light" type="submit" title="Move Down"><i class="bi bi-arrow-down"></i></button>
              </form>
            </td>
            <td>
              <form action="/admin/gtp-schema/fields/<%= f.id %>/delete" method="POST" onsubmit="return confirm('Delete this field? Any values already saved on orders stay in the database but stop being shown.');">
                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (!g.fields.length) { %><tr><td colspan="9" class="text-muted small">No fields in this group yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="card-body border-top">
      <form action="/admin/gtp-schema/fields" method="POST" class="row g-2 align-items-center">
        <input type="hidden" name="group_id" value="<%= g.id %>">
        <div class="col-md-2"><input type="text" name="field_key" class="form-control form-control-sm" placeholder="field_key" required pattern="[a-z][a-z0-9_]{1,79}"></div>
        <div class="col-md-2"><input type="text" name="label" class="form-control form-control-sm" placeholder="Label" required></div>
        <div class="col-md-1"><input type="text" name="unit" class="form-control form-control-sm" placeholder="Unit"></div>
        <div class="col-md-2">
          <select name="field_type" class="form-select form-select-sm">
            <% FIELD_TYPES.forEach(function(ft) { %><option value="<%= ft %>"><%= ft %></option><% }); %>
          </select>
        </div>
        <div class="col-md-2"><input type="text" name="select_options" class="form-control form-control-sm" placeholder="opt1,opt2 (if select)"></div>
        <div class="col-md-2">
          <select name="stage_codes" class="form-select form-select-sm" multiple size="1" title="Which stages show this field">
            <% stages.forEach(function(s) { %><option value="<%= s.stage_code %>"><%= s.stage_code %></option><% }); %>
          </select>
        </div>
        <div class="col-md-1"><button class="btn btn-sm btn-primary w-100" type="submit">Add Field</button></div>
      </form>
    </div>
  </div>
<% }); %>

<div class="card" style="max-width:700px;">
  <div class="card-header">Add Field Group</div>
  <div class="card-body">
    <form action="/admin/gtp-schema/groups" method="POST" class="row g-2">
      <div class="col-md-5"><input type="text" name="name" class="form-control" placeholder="Group name, e.g. Fire Protection" required></div>
      <div class="col-md-4">
        <select name="transformer_type_id" class="form-select">
          <option value="">All Transformer Types</option>
          <% transformerTypes.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-2"><input type="number" name="sequence_order" class="form-control" placeholder="Order #"></div>
      <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">Add</button></div>
    </form>
  </div>
</div>

</div>
</div>
