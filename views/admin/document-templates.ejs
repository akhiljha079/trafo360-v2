<h4 class="mb-3">Document Templates</h4>
<p class="text-muted">Controls the technical-document generation engine (Documents &rarr; Generate Document, available on Job/Order/Lot pages). Each document type pulls GTP parameters tagged to the stages listed here.</p>

<% templates.forEach(function(t) { %>
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div><b><%= t.name %></b> <span class="badge bg-light text-dark ms-1"><%= DOCUMENT_TYPES[t.doc_type] ? DOCUMENT_TYPES[t.doc_type].scope : '' %>-level</span></div>
      <form action="/admin/document-templates/<%= t.id %>/toggle" method="POST">
        <button class="btn btn-sm <%= t.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
          <%= t.is_active ? 'Enabled' : 'Disabled' %>
        </button>
      </form>
    </div>
    <div class="card-body">
      <form action="/admin/document-templates/<%= t.id %>" method="POST" class="row g-2">
        <div class="col-md-4">
          <label class="form-label small mb-1">Display Name</label>
          <input type="text" name="name" class="form-control form-control-sm" value="<%= t.name %>">
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1">Numbering Prefix</label>
          <input type="text" name="numbering_prefix" class="form-control form-control-sm" value="<%= t.numbering_prefix %>">
        </div>
        <div class="col-md-6">
          <label class="form-label small mb-1">Source Stages (which GTP-tagged fields feed this document)</label>
          <select name="source_stage_codes" class="form-select form-select-sm" multiple size="3">
            <% var current = (t.source_stage_codes || '').split(',').map(function(s){return s.trim();}); %>
            <% stages.forEach(function(s) { %>
              <option value="<%= s.stage_code %>" <%= current.includes(s.stage_code) ? 'selected' : '' %>><%= s.stage_code %> - <%= s.stage_name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-12">
          <label class="form-label small mb-1">Intro Text</label>
          <textarea name="intro_text" class="form-control form-control-sm" rows="2"><%= t.intro_text || '' %></textarea>
        </div>
        <div class="col-md-12"><button class="btn btn-sm btn-primary" type="submit">Save</button></div>
      </form>
    </div>
  </div>
<% }); %>
