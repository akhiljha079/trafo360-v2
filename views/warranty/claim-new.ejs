<h4 class="mb-3">New Warranty Claim &mdash; <%= warranty.job_no %></h4>
<p class="text-muted small"><%= warranty.customer_name %></p>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="/warranty/<%= warranty.id %>/claims" method="POST">
          <div class="mb-3">
            <label class="form-label">Customer Complaint *</label>
            <textarea name="customer_complaint" class="form-control" rows="4" required placeholder="Describe the reported issue"></textarea>
          </div>
          <div class="mb-3" style="max-width:220px;">
            <label class="form-label">Date Raised</label>
            <input type="date" name="raised_date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>">
          </div>
          <button type="submit" class="btn btn-primary">Raise Claim</button>
          <a href="/warranty/<%= warranty.id %>" class="btn btn-outline-secondary">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
