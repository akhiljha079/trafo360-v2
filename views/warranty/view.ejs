<%
  var ragByStatus = { Active: 'green', Expiring: 'amber', Expired: 'red', Void: 'gray' };
  var claimBadge = { Open: 'bg-secondary', Investigating: 'bg-warning text-dark', Resolved: 'bg-success', Rejected: 'bg-danger', Closed: 'bg-dark' };
  function warrPerm(action) { return currentUser.is_admin || (currentUser.permissions.warranty && currentUser.permissions.warranty[action]); }
%>
<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0"><%= warranty.job_no %> &mdash; <%= warranty.customer_name %></h4>
    <div class="text-muted small"><%= warranty.transformer_type %> &middot; <%= warranty.rating || 'N/A' %> &middot; Serial: <%= warranty.serial_no || 'N/A' %></div>
  </div>
  <div class="text-end">
    <span class="badge badge-rag-<%= ragByStatus[warranty.status] %> fs-6 mb-2"><%= warranty.status %></span><br>
    <a href="/jobs/<%= warranty.job_id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-diagram-3"></i> View Job</a>
    <% if (warrPerm('create')) { %><a href="/warranty/<%= warranty.id %>/claims/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> New Claim</a><% } %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header">Warranty Details</div>
  <div class="card-body">
    <table class="table table-sm mb-0">
      <tr><th style="width:200px;">Start Date</th><td><%= warranty.start_date %></td></tr>
      <tr><th>End Date</th><td><%= warranty.end_date %></td></tr>
      <tr><th>Duration</th><td><%= warranty.duration_months %> months</td></tr>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header">Claims (<%= claims.length %>)</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Claim No.</th><th>Raised</th><th>Complaint</th><th>Status</th><th>Assigned To</th><th></th></tr></thead>
      <tbody>
      <% claims.forEach(function(c) { %>
        <tr>
          <td><%= c.claim_no %></td>
          <td class="small"><%= c.raised_date %></td>
          <td class="small"><%= c.customer_complaint.length > 60 ? c.customer_complaint.slice(0,60) + '...' : c.customer_complaint %></td>
          <td><span class="badge <%= claimBadge[c.status] %>"><%= c.status %></span></td>
          <td class="small"><%= c.assigned_to_name || '-' %></td>
          <td><a href="/warranty/claims/<%= c.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }); %>
      <% if (claims.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No claims raised for this unit yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
