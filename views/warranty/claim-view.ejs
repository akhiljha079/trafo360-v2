<%
  var claimBadge = { Open: 'bg-secondary', Investigating: 'bg-warning text-dark', Resolved: 'bg-success', Rejected: 'bg-danger', Closed: 'bg-dark' };
  function warrPerm(action) { return currentUser.is_admin || (currentUser.permissions.warranty && currentUser.permissions.warranty[action]); }
  var NEXT_STATUSES = { Open: ['Investigating'], Investigating: ['Resolved', 'Rejected'], Resolved: ['Closed'], Rejected: ['Closed'], Closed: [] };
  var nextOptions = NEXT_STATUSES[claim.status] || [];
  var decisionStatuses = ['Resolved', 'Rejected'];
%>
<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0">Claim <%= claim.claim_no %></h4>
    <div class="text-muted small"><a href="/warranty/<%= claim.warranty_id %>"><%= claim.job_no %> - <%= claim.customer_name %></a></div>
  </div>
  <span class="badge <%= claimBadge[claim.status] %> fs-6"><%= claim.status %></span>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header">Claim Details</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><th style="width:200px;">Raised By</th><td><%= claim.raised_by_name || '-' %> on <%= claim.raised_date %></td></tr>
          <tr><th>Complaint</th><td><%= claim.customer_complaint %></td></tr>
          <tr><th>Assigned To</th><td><%= claim.assigned_to_name || '-' %></td></tr>
          <tr><th>Site Visit Date</th><td><%= claim.site_visit_date || '-' %></td></tr>
          <tr><th>Resolution Notes</th><td><%= claim.resolution_notes || '-' %></td></tr>
          <tr><th>Resolved Date</th><td><%= claim.resolved_date || '-' %></td></tr>
          <tr><th>Closed Date</th><td><%= claim.closed_date || '-' %></td></tr>
        </table>
      </div>
    </div>

    <% var canAct = nextOptions.some(function(s) { return warrPerm(decisionStatuses.includes(s) ? 'approve' : 'edit'); }); %>
    <% if (canAct) { %>
    <div class="card mb-3">
      <div class="card-header">Update Claim</div>
      <div class="card-body">
        <form action="/warranty/claims/<%= claim.id %>/update" method="POST" class="row g-2">
          <div class="col-md-4">
            <label class="form-label small">Move To</label>
            <select name="new_status" class="form-select form-select-sm">
              <option value="">-- No status change --</option>
              <% nextOptions.forEach(function(s) { %>
                <% if (warrPerm(decisionStatuses.includes(s) ? 'approve' : 'edit')) { %>
                  <option value="<%= s %>"><%= s %></option>
                <% } %>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Assign To</label>
            <select name="assigned_to" class="form-select form-select-sm">
              <option value="">-- Unassigned --</option>
              <% assignable.forEach(function(u) { %>
                <option value="<%= u.id %>" <%= String(claim.assigned_to)===String(u.id)?'selected':'' %>><%= u.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small">Site Visit Date</label>
            <input type="date" name="site_visit_date" class="form-control form-control-sm" value="<%= claim.site_visit_date || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label small">Resolution Notes</label>
            <textarea name="resolution_notes" class="form-control form-control-sm" rows="2"><%= claim.resolution_notes || '' %></textarea>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-header">Parts Used</div>
      <div class="card-body">
        <table class="table table-sm mb-3">
          <thead><tr><th>Part</th><th>Qty</th><th>Notes</th></tr></thead>
          <tbody>
          <% parts.forEach(function(p) { %>
            <tr><td><%= p.part_name %></td><td><%= p.quantity %></td><td class="small text-muted"><%= p.notes || '' %></td></tr>
          <% }); %>
          <% if (parts.length === 0) { %><tr><td colspan="3" class="text-muted small">No parts recorded.</td></tr><% } %>
          </tbody>
        </table>
        <% if (warrPerm('edit')) { %>
        <form action="/warranty/claims/<%= claim.id %>/parts" method="POST" class="row g-2">
          <div class="col-md-5"><input type="text" name="part_name" class="form-control form-control-sm" placeholder="Part name" required></div>
          <div class="col-md-2"><input type="number" name="quantity" class="form-control form-control-sm" placeholder="Qty" value="1" min="1"></div>
          <div class="col-md-4"><input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes"></div>
          <div class="col-md-1"><button type="submit" class="btn btn-sm btn-outline-primary w-100">Add</button></div>
        </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">Attached Documents</div>
      <div class="card-body">
        <% documents.forEach(function(d) { %>
          <div class="d-flex justify-content-between border-bottom py-2">
            <div>
              <div class="fw-bold small"><%= d.doc_code %></div>
              <div class="small text-muted"><%= d.doc_name %></div>
            </div>
            <a href="/documents/<%= d.id %>" class="btn btn-sm btn-outline-primary">View</a>
          </div>
        <% }); %>
        <% if (documents.length === 0) { %><p class="text-muted small mb-3">No documents attached yet.</p><% } %>
        <% if (warrPerm('edit')) { %>
        <form action="/warranty/claims/<%= claim.id %>/documents" method="POST" enctype="multipart/form-data" class="mt-3 d-flex gap-2">
          <input type="file" name="file" class="form-control form-control-sm" required>
          <button type="submit" class="btn btn-sm btn-primary text-nowrap">Attach</button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
