<h4 class="mb-3">Add Accounting Document</h4>
<p class="text-muted small">Invoices, payment receipts, e-way bills, and vendor POs - document collection only, no ledger or tax calculations.</p>
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <form action="/accounting" method="POST" enctype="multipart/form-data">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Document Name *</label>
              <input type="text" name="doc_name" class="form-control" required placeholder="Invoice - ORD-2026-014">
            </div>
            <div class="col-md-6">
              <label class="form-label">Category *</label>
              <select name="category_id" class="form-select" required>
                <option value="">-- Select --</option>
                <% categories.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Confidentiality *</label>
              <select name="confidentiality" class="form-select" required>
                <option value="Public">Public</option>
                <option value="Internal" selected>Internal</option>
                <option value="Confidential">Confidential</option>
                <option value="Highly Confidential">Highly Confidential</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Linked Order</label>
              <select name="related_order_id" class="form-select">
                <option value="">-- None --</option>
                <% orders.forEach(function(o) { %>
                  <option value="<%= o.id %>"><%= o.order_no %> - <%= o.customer_name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Linked Transformer Job</label>
              <select name="related_job_id" class="form-select">
                <option value="">-- None --</option>
                <% jobs.forEach(function(j) { %>
                  <option value="<%= j.id %>"><%= j.job_no %> - <%= j.customer_name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-12">
              <label class="form-label">Upload File</label>
              <input type="file" name="file" class="form-control">
              <div class="form-text">Image uploads (JPG/PNG) are automatically scanned with OCR to help you search for them later.</div>
            </div>
            <div class="col-md-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="customer_visible" id="customer_visible" value="1">
                <label class="form-check-label" for="customer_visible">Visible in the Customer Portal (only if linked to a portal customer's order/job)</label>
              </div>
            </div>
          </div>
          <div class="mt-4">
            <button type="submit" class="btn btn-primary">Add Document</button>
            <a href="/accounting" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
