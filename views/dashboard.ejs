<% if (moduleTiles.length) { %>
<div class="row g-3 mb-4">
  <% moduleTiles.forEach(function(t, i) { %>
    <div class="col-lg-2 col-md-4 col-6">
      <a href="<%= t.href %>" class="module-tile module-tile-<%= t.key %>" data-animate style="transition-delay: <%= i * 40 %>ms;">
        <div class="module-tile-icon"><i class="bi <%= t.icon %>"></i></div>
        <div>
          <div class="module-tile-stat"><%= t.stat %></div>
          <div class="module-tile-label"><%= t.label %></div>
        </div>
      </a>
    </div>
  <% }); %>
</div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0">Dashboard</h4>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#customizePanel">
      <i class="bi bi-sliders"></i> Customize Dashboard
    </button>
    <a href="/project-status" class="btn btn-sm btn-outline-primary"><i class="bi bi-speedometer"></i> View Project Status</a>
  </div>
</div>

<div class="collapse mb-3" id="customizePanel">
  <div class="card">
    <div class="card-header">Customize Dashboard</div>
    <div class="card-body">
      <p class="text-muted small">Show/hide and reorder your own dashboard widgets. Only you see this - it doesn't affect anyone else.</p>
      <table class="table table-sm align-middle mb-0">
        <tbody>
        <% allWidgetPrefs.forEach(function(w) { %>
          <tr>
            <td><%= w.label %></td>
            <td style="width:110px;">
              <form action="/dashboard/widgets/<%= w.key %>/toggle" method="POST">
                <button class="btn btn-sm <%= w.isVisible ? 'btn-outline-success' : 'btn-outline-secondary' %>" type="submit">
                  <%= w.isVisible ? 'Shown' : 'Hidden' %>
                </button>
              </form>
            </td>
            <td style="width:90px;">
              <form action="/dashboard/widgets/<%= w.key %>/reorder" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button class="btn btn-sm btn-light" type="submit" title="Move Up"><i class="bi bi-arrow-up"></i></button>
              </form>
              <form action="/dashboard/widgets/<%= w.key %>/reorder" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button class="btn btn-sm btn-light" type="submit" title="Move Down"><i class="bi bi-arrow-down"></i></button>
              </form>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-3">
  <% widgets.forEach(function(w) { %>
    <div class="<%= w.key === 'stats' ? 'col-12' : 'col-lg-6' %>">
      <%- include('partials/widgets/' + w.key, locals) %>
    </div>
  <% }); %>
  <% if (!widgets.length) { %>
    <div class="col-12"><p class="text-muted">All widgets are hidden - use "Customize Dashboard" above to show some.</p></div>
  <% } %>
</div>
