<%
  // The job's current stage determines which module governs stage-transition
  // actions (advance/set-stage) - matches requireJobPhaseModule() in
  // middleware/auth.js, since one job flows through all three phases.
  var jobModuleKey = job.phase === 'Sales' ? 'sales' : job.phase === 'Dispatch' ? 'dispatch' : 'manufacturing';
  function canEdit(key) { return currentUser.is_admin || (currentUser.permissions[key] && currentUser.permissions[key].edit); }
  function canDelete(key) { return currentUser.is_admin || (currentUser.permissions[key] && currentUser.permissions[key].delete); }
  var warrantyBadge = warranty ? { Active: 'bg-success', Expiring: 'bg-warning text-dark', Expired: 'bg-danger', Void: 'bg-secondary' }[warranty.status] : null;
%>
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
  <div>
    <% if (job.order_no) { %>
      <div class="small mb-1"><a href="/orders/<%= job.order_id %>" class="text-decoration-none">&larr; <%= job.order_no %></a> / <%= job.lot_name %> / Unit #<%= job.unit_no %></div>
    <% } %>
    <h4 class="mb-0"><%= job.job_no %> &mdash; <%= job.customer_name %></h4>
    <div class="text-muted small"><%= job.transformer_type %> &middot; <%= job.rating || 'N/A' %> &middot; Serial: <%= job.serial_no || 'N/A' %> &middot; PO: <%= job.po_no || 'N/A' %></div>
    <div class="mt-2">
      <span class="badge badge-rag-<%= rag %>"><%= ragLabel %></span>
      <span class="badge bg-secondary"><%= job.status %></span>
      <% if (warranty) { %>
        <a href="/warranty/<%= warranty.id %>" class="badge <%= warrantyBadge %> text-decoration-none"><i class="bi bi-shield-check"></i> Warranty: <%= warranty.status %></a>
      <% } %>
    </div>
    <div class="mt-2">
      <form action="/jobs/<%= job.id %>/target-date" method="POST" class="d-flex align-items-center gap-2">
        <label class="small text-muted mb-0">Target Dispatch Date:</label>
        <input type="date" name="target_dispatch_date" class="form-control form-control-sm" style="width:160px;" value="<%= job.target_dispatch_date || '' %>" <%= canEdit('manufacturing') ? '' : 'disabled' %>>
        <% if (canEdit('manufacturing')) { %><button class="btn btn-sm btn-outline-secondary" type="submit">Save</button><% } %>
      </form>
    </div>
    <% if (canEdit('manufacturing') || canDelete('manufacturing')) { %>
      <div class="mt-2">
        <% if (canEdit('manufacturing')) { %><a href="/jobs/<%= job.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a><% } %>
        <% if (canDelete('manufacturing')) { %>
        <form action="/jobs/<%= job.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this job? Stage history is preserved for audit but the job will be archived.')">
          <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Delete</button>
        </form>
        <% } %>
      </div>
    <% } %>
  </div>
  <%- include('../partials/transformer-status', { pct: progressPct, phase: job.phase, rag: rag, size: 'lg', caption: progressPct + '% built' }) %>
</div>

<ul class="nav tabs-modern mb-3" role="tablist">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button"><i class="bi bi-speedometer2"></i> Overview</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button"><i class="bi bi-folder2-open"></i> Documents<% if (missingMandatory.length) { %> <span class="badge bg-danger"><%= missingMandatory.length %></span><% } %></button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-history" type="button"><i class="bi bi-clock-history"></i> Stage History</button></li>
</ul>

<div class="tab-content">
<div class="tab-pane fade show active" id="tab-overview">

<div class="card mb-3">
  <div class="card-header">Workflow Progress</div>
  <div class="card-body">
    <div class="stage-track mb-3">
      <% var reachedCurrent = false; %>
      <% allStages.forEach(function(s) { %>
        <% var cls = 'stage-pill'; %>
        <% if (job.current_stage_id === s.id) { cls += ' current'; reachedCurrent = true; }
           else if (!reachedCurrent) { cls += ' done'; } %>
        <span class="<%= cls %>" title="<%= s.phase %>"><%= s.stage_code %></span>
      <% }); %>
    </div>
    <p class="mb-1"><b>Current Stage:</b>
      <% if (job.stage_name) { %><span class="badge badge-phase-<%= job.phase %>"><%= job.stage_code %> - <%= job.stage_name %></span><% } else { %>Not started<% } %>
    </p>

    <% if (canEdit(jobModuleKey) && job.status === 'Active') { %>
    <div class="mt-3 d-flex flex-wrap gap-2">
      <form action="/jobs/<%= job.id %>/advance" method="POST" class="d-flex gap-2">
        <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Remarks (optional)" style="width:260px;">
        <button class="btn btn-sm btn-primary" type="submit">
          <% if (nextStage) { %>Advance to: <%= nextStage.stage_name %><% } else { %>Mark Job Completed<% } %>
        </button>
      </form>

      <form action="/jobs/<%= job.id %>/set-stage" method="POST" class="d-flex gap-2">
        <select name="stage_id" class="form-select form-select-sm" style="width:220px;" required>
          <option value="">Jump to stage...</option>
          <% allStages.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.stage_code %> - <%= s.stage_name %></option>
          <% }); %>
        </select>
        <button class="btn btn-sm btn-outline-secondary" type="submit">Set Stage</button>
      </form>

      <form action="/jobs/<%= job.id %>/status" method="POST">
        <input type="hidden" name="status" value="On Hold">
        <button class="btn btn-sm btn-outline-warning" type="submit">Put On Hold</button>
      </form>
      <form action="/jobs/<%= job.id %>/status" method="POST">
        <input type="hidden" name="status" value="Cancelled">
        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Cancel this job?')">Cancel Job</button>
      </form>
    </div>
    <% } else if (canEdit(jobModuleKey) && job.status !== 'Active') { %>
      <form action="/jobs/<%= job.id %>/status" method="POST" class="mt-2">
        <input type="hidden" name="status" value="Active">
        <button class="btn btn-sm btn-outline-success" type="submit">Reactivate Job</button>
      </form>
    <% } %>
  </div>
</div>

</div>

<div class="tab-pane fade" id="tab-documents">

<% if (requirements.length > 0) { %>
<div class="card mb-3">
  <div class="card-header">Required Documents for Current Stage
    <% if (missingMandatory.length) { %><span class="badge bg-danger float-end"><%= missingMandatory.length %> missing</span><% } else { %><span class="badge bg-success float-end">All satisfied</span><% } %>
  </div>
  <div class="card-body">
    <% requirements.forEach(function(r) { %>
      <div class="d-flex justify-content-between align-items-center border-bottom py-2">
        <div>
          <% if (r.uploads.length > 0) { %><i class="bi bi-check-circle-fill text-success"></i><% } else if (r.is_mandatory) { %><i class="bi bi-x-circle-fill text-danger"></i><% } else { %><i class="bi bi-dash-circle text-muted"></i><% } %>
          <b><%= r.requirement_name %></b>
          <% if (r.is_mandatory) { %><span class="badge bg-danger ms-1">Mandatory</span><% } else { %><span class="badge bg-secondary ms-1">Optional</span><% } %>
          <% r.uploads.forEach(function(u) { %>
            <div class="small text-muted ms-4">
              <a href="/jobs/<%= job.id %>/stage-documents/<%= u.id %>/download"><%= u.original_name || 'Download' %></a>
              &mdash; by <%= u.uploaded_by_name %> on <%= u.uploaded_at %>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
    <form action="/jobs/<%= job.id %>/stage-documents" method="POST" enctype="multipart/form-data" class="mt-3 d-flex flex-wrap gap-2 align-items-end">
      <div>
        <label class="form-label small mb-1">Upload for</label>
        <select name="requirement_id" class="form-select form-select-sm" style="width:220px;">
          <% requirements.forEach(function(r) { %><option value="<%= r.id %>"><%= r.requirement_name %></option><% }); %>
        </select>
      </div>
      <div>
        <label class="form-label small mb-1">File</label>
        <input type="file" name="file" class="form-control form-control-sm" required>
      </div>
      <button type="submit" class="btn btn-sm btn-primary">Upload</button>
    </form>
  </div>
</div>
<% } %>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">Linked Documents</div>
      <div class="card-body">
        <% if (documents.length === 0) { %><p class="text-muted mb-0">No documents linked to this job yet.</p><% } %>
        <% documents.forEach(function(d) { %>
          <div class="d-flex justify-content-between border-bottom py-2">
            <div>
              <div class="fw-bold"><%= d.doc_code %></div>
              <div class="small text-muted"><%= d.doc_name %></div>
            </div>
            <a href="/documents/<%= d.id %>" class="btn btn-sm btn-outline-primary">View</a>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <% if (genDocTypes && genDocTypes.length) { %>
    <div class="card">
      <div class="card-header"><i class="bi bi-file-earmark-pdf"></i> Generate Document</div>
      <div class="card-body">
        <form action="/jobs/<%= job.id %>/generate-document" method="POST" class="d-flex gap-2">
          <select name="doc_type" class="form-select form-select-sm" required>
            <% genDocTypes.forEach(function(t) { %><option value="<%= t.doc_type %>"><%= t.name %></option><% }); %>
          </select>
          <button class="btn btn-sm btn-primary" type="submit">Generate</button>
        </form>
        <div class="form-text">Generates a PDF from this unit's GTP data and adds it to the Document Library.</div>
      </div>
    </div>
    <% } %>
  </div>
</div>

</div>

<div class="tab-pane fade" id="tab-history">

<div class="card">
  <div class="card-header">Stage History</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <thead><tr><th>Date/Time</th><th>Stage</th><th>Event</th><th>By</th><th>Remarks</th></tr></thead>
      <tbody>
      <% history.forEach(function(h) { %>
        <tr>
          <td class="small"><%= h.action_at %></td>
          <td><span class="badge badge-phase-<%= h.phase %>"><%= h.stage_name %></span></td>
          <td><%= h.event %></td>
          <td><%= h.updated_by_name || '-' %></td>
          <td class="small text-muted"><%= h.remarks || '' %></td>
        </tr>
      <% }); %>
      <% if (history.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-3">No history yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

</div>
</div>
