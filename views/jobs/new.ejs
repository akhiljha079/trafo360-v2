<h4 class="mb-3">New Transformer Job</h4>
<div class="card">
  <div class="card-body">
    <form action="/jobs" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Job No. *</label>
          <input type="text" name="job_no" class="form-control" required placeholder="JOB0876">
        </div>
        <div class="col-md-4">
          <label class="form-label">Customer PO No.</label>
          <input type="text" name="po_no" class="form-control" placeholder="PO4521">
        </div>
        <div class="col-md-4">
          <label class="form-label">Serial No.</label>
          <input type="text" name="serial_no" class="form-control" placeholder="SR2026-114">
        </div>
        <div class="col-md-6">
          <label class="form-label">Customer Name *</label>
          <input type="text" name="customer_name" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Transformer Type *</label>
          <select name="transformer_type" class="form-select" required>
            <% transformerTypes.forEach(function(t) { %><option value="<%= t.name %>"><%= t.name %></option><% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Rating</label>
          <input type="text" name="rating" class="form-control" placeholder="1600kVA, 11/0.433kV">
        </div>
        <div class="col-md-3">
          <label class="form-label">Target Dispatch Date</label>
          <input type="date" name="target_dispatch_date" class="form-control">
        </div>
      </div>
      <% if (firstStage) { %>
        <p class="text-muted mt-3 mb-0 small">This job will start at stage: <b><%= firstStage.stage_code %> - <%= firstStage.stage_name %></b> (<%= firstStage.phase %>)</p>
      <% } %>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create Job</button>
        <a href="/jobs" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
