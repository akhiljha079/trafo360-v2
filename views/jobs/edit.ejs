<h4 class="mb-3">Edit <%= job.job_no %></h4>
<div class="card" style="max-width:700px;">
  <div class="card-body">
    <% if (job.order_id) { %>
      <p class="text-muted small">This unit belongs to an Order/Lot. Job No. and quantity structure are managed from the Order; you can still edit these unit-specific details.</p>
    <% } %>
    <form action="/jobs/<%= job.id %>/edit" method="POST">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Job No.</label>
          <input type="text" class="form-control" value="<%= job.job_no %>" disabled>
          <div class="form-text">Job No. cannot be changed after creation.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Customer PO No.</label>
          <input type="text" name="po_no" class="form-control" value="<%= job.po_no || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Customer Name *</label>
          <input type="text" name="customer_name" class="form-control" required value="<%= job.customer_name %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">Transformer Type *</label>
          <select name="transformer_type" class="form-select" required>
            <% transformerTypes.forEach(function(t) { %>
              <option value="<%= t.name %>" <%= job.transformer_type===t.name ? 'selected' : '' %>><%= t.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Rating</label>
          <input type="text" name="rating" class="form-control" value="<%= job.rating || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Serial No.</label>
          <input type="text" name="serial_no" class="form-control" value="<%= job.serial_no || '' %>">
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/jobs/<%= job.id %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
