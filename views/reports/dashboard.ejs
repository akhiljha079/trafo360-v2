<h4 class="mb-1">Reports</h4>
<p class="text-muted small mb-4">Exportable, date-ranged reports per module. For live charts and trends, see <a href="/analytics">Analytics</a>.</p>

<div class="entity-card-grid">
  <% Object.keys(reports).forEach(function(key, i) { %>
    <% var r = reports[key]; %>
    <a href="/reports/<%= key %>" class="module-tile module-tile-<%= key %>" data-animate style="transition-delay: <%= i * 40 %>ms;">
      <div class="module-tile-icon"><i class="bi <%= r.icon %>"></i></div>
      <div>
        <div class="module-tile-stat" style="font-size:1.05rem;"><%= r.label %></div>
        <div class="module-tile-label">View, filter & export</div>
      </div>
    </a>
  <% }); %>
</div>
