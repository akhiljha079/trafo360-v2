<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi <%= report.icon %>"></i> <%= report.label %> Report</h4>
  <div class="d-flex gap-2">
    <a href="/reports/<%= reportType %>/export.csv?from=<%= from %>&to=<%= to %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-filetype-csv"></i> Export CSV</a>
    <a href="/reports/<%= reportType %>/export.pdf?from=<%= from %>&to=<%= to %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-filetype-pdf"></i> Export PDF</a>
  </div>
</div>

<form class="row g-2 mb-3" method="GET">
  <div class="col-md-3">
    <label class="form-label small mb-1">From</label>
    <input type="date" name="from" class="form-control" value="<%= from %>">
  </div>
  <div class="col-md-3">
    <label class="form-label small mb-1">To</label>
    <input type="date" name="to" class="form-control" value="<%= to %>">
  </div>
  <div class="col-md-2 d-flex align-items-end">
    <button class="btn btn-outline-primary w-100" type="submit">Apply</button>
  </div>
</form>

<div class="card">
  <div class="card-header"><%= rows.length %> record(s)</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 table-sm">
      <thead><tr><% report.columns.forEach(function(c) { %><th><%= c.label %></th><% }); %></tr></thead>
      <tbody>
      <% rows.forEach(function(r) { %>
        <tr><% report.columns.forEach(function(c) { %><td class="small"><%= r[c.key] !== null && r[c.key] !== undefined ? r[c.key] : '-' %></td><% }); %></tr>
      <% }); %>
      <% if (rows.length === 0) { %><tr><td colspan="<%= report.columns.length %>" class="text-center text-muted py-4">No records in this date range.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
