<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-gear-wide-connected"></i> Manufacturing Overview</h4>
  <div class="d-flex gap-2">
    <a href="/jobs/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> New Job</a>
    <a href="/jobs" class="btn btn-sm btn-outline-secondary">All Jobs</a>
    <a href="/orders" class="btn btn-sm btn-outline-secondary">Orders & Lots</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold badge-phase-Manufacturing text-white rounded-3 py-1"><%= inManufacturing %></div>
      <div class="text-muted small mt-1">Units in Manufacturing</div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold"><%= activeLots %></div>
      <div class="text-muted small">Active Lots</div>
    </div>
  </div>
  <div class="col-md-6 col-12">
    <div class="card p-3" data-animate>
      <div class="text-muted small mb-1">Units by Stage</div>
      <% byStage.forEach(function(s) { %>
        <div class="d-flex justify-content-between small"><span><%= s.stage_name %></span><strong><%= s.cnt %></strong></div>
      <% }); %>
      <% if (!byStage.length) { %><span class="text-muted small">No units currently in Manufacturing.</span><% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">Units Currently in Manufacturing</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Job No.</th><th>Customer</th><th>Order / Lot</th><th>Stage</th><th style="width:160px;">Progress</th><th></th></tr></thead>
      <tbody>
      <% jobs.forEach(function(j) { %>
        <tr>
          <td><%= j.job_no %></td>
          <td><%= j.customer_name %></td>
          <td class="small"><%= j.order_no || '-' %><% if (j.lot_name) { %> / <%= j.lot_name %><% } %></td>
          <td><span class="badge badge-phase-<%= j.phase %>"><%= j.stage_code %></span> <span class="small"><%= j.stage_name %></span></td>
          <td>
            <div class="progress-track"><div class="progress-fill" style="width:<%= j.progressPct %>%;"></div></div>
            <div class="small text-muted"><%= j.progressPct %>%</div>
          </td>
          <td><a href="/jobs/<%= j.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }); %>
      <% if (!jobs.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No units currently in Manufacturing.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
