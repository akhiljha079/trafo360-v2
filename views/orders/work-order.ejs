<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Work Order - <%= stage.stage_name %></title>
  <style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; color: #1B2430; margin: 0; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #F5A623; padding-bottom: 10px; margin-bottom: 16px; }
    .company { font-size: 18px; font-weight: 800; color: #0F3B5F; }
    .company small { display: block; font-weight: 400; color: #666; font-size: 11px; }
    .doc-title { text-align: right; }
    .doc-title h2 { margin: 0; color: #0F3B5F; font-size: 16px; }
    .doc-title .stage-badge { display: inline-block; background: #0F3B5F; color: #fff; padding: 2px 10px; border-radius: 10px; font-size: 11px; margin-top: 4px; }
    .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 12px; }
    .meta-table td { padding: 4px 8px; border: 1px solid #E4E9F0; }
    .meta-table td.label { font-weight: bold; background: #F4F7FB; width: 25%; }
    h3.section { color: #0F3B5F; border-bottom: 1px solid #E4E9F0; padding-bottom: 4px; margin-top: 22px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
    table.params { width: 100%; border-collapse: collapse; font-size: 12px; }
    table.params td { padding: 5px 8px; border: 1px solid #E4E9F0; }
    table.params td.pname { width: 50%; color: #444; }
    table.params td.pval { font-weight: bold; }
    table.units { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 8px; }
    table.units th, table.units td { padding: 4px 6px; border: 1px solid #E4E9F0; text-align: left; }
    table.units th { background: #0F3B5F; color: #fff; }
    .sign-row { display: flex; justify-content: space-between; margin-top: 40px; }
    .sign-box { width: 30%; border-top: 1px solid #333; padding-top: 4px; font-size: 11px; text-align: center; }
    .no-print { margin-bottom: 16px; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <div class="no-print"><button onclick="window.print()">Print / Save as PDF</button></div>

  <div class="header">
    <div class="company">TRAFO POWER & ELECTRICALS PVT. LTD.
      <small>Sikandra, Agra, Uttar Pradesh &middot; ISO 9001:2015 Certified</small>
    </div>
    <div class="doc-title">
      <h2>Department Work Order</h2>
      <span class="stage-badge"><%= stage.stage_code %> &middot; <%= stage.stage_name %></span>
    </div>
  </div>

  <table class="meta-table">
    <tr>
      <td class="label">Order No.</td><td><%= order.order_no %></td>
      <td class="label">Customer</td><td><%= order.customer_name %></td>
    </tr>
    <tr>
      <td class="label">Transformer Type</td><td><%= order.transformer_type %></td>
      <td class="label">Rating</td><td><%= order.rating || '-' %></td>
    </tr>
    <% if (lot) { %>
    <tr>
      <td class="label">Lot</td><td><%= lot.lot_name %> (<%= lot.quantity %> units)</td>
      <td class="label">Planned Completion</td><td><%= lot.planned_completion_date || '-' %></td>
    </tr>
    <% } %>
  </table>

  <h3 class="section">GTP Parameters Relevant to <%= stage.stage_name %></h3>
  <table class="params">
    <% fields.forEach(function(f) { %>
      <tr><td class="pname"><%= f.label %> <% if (f.unit) { %>(<%= f.unit %>)<% } %></td><td class="pval"><%= f.value || '-' %></td></tr>
    <% }); %>
    <% if (fields.length === 0) { %><tr><td colspan="2" style="color:#888;">No GTP parameters tagged for this stage yet.</td></tr><% } %>
  </table>

  <% if (lot && units.length) { %>
  <h3 class="section">Units in This Lot</h3>
  <table class="units">
    <thead><tr><th>Unit #</th><th>Job No.</th><th>Serial No.</th><th>Remarks</th></tr></thead>
    <tbody>
      <% units.forEach(function(u) { %>
        <tr><td>#<%= u.unit_no %></td><td><%= u.job_no %></td><td><%= u.serial_no || '' %></td><td></td></tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <div class="sign-row">
    <div class="sign-box">Issued By</div>
    <div class="sign-box">Department Received By</div>
    <div class="sign-box">Date</div>
  </div>
</body>
</html>
