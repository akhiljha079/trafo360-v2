<h4 class="mb-3">Search Results<% if (q) { %>: "<%= q %>"<% } %></h4>

<form action="/search" method="GET" class="mb-4" style="max-width:420px;">
  <div class="input-group">
    <input type="search" name="q" class="form-control" value="<%= q %>" placeholder="Search jobs, orders, documents...">
    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
  </div>
</form>

<% if (!q) { %>
  <p class="text-muted">Enter a search term above.</p>
<% } else if (!jobs.length && !orders.length && !documents.length) { %>
  <p class="text-muted">No matches for "<%= q %>".</p>
<% } else { %>

<% if (jobs.length) { %>
<div class="card mb-3">
  <div class="card-header">Transformer Jobs (<%= jobs.length %>)</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <tbody>
      <% jobs.forEach(function(j) { %>
        <tr>
          <td><a href="/jobs/<%= j.id %>"><%= j.job_no %></a></td>
          <td><%= j.customer_name %></td>
          <td><span class="badge bg-secondary"><%= j.status %></span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (orders.length) { %>
<div class="card mb-3">
  <div class="card-header">Orders (<%= orders.length %>)</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td><a href="/orders/<%= o.id %>"><%= o.order_no %></a></td>
          <td><%= o.customer_name %></td>
          <td><span class="badge bg-secondary"><%= o.status %></span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (documents.length) { %>
<div class="card mb-3">
  <div class="card-header">Documents (<%= documents.length %>)</div>
  <div class="table-responsive">
    <table class="table table-sm mb-0">
      <tbody>
      <% documents.forEach(function(d) { %>
        <tr>
          <td><a href="/documents/<%= d.id %>"><%= d.doc_code %></a></td>
          <td><%= d.doc_name %></td>
          <td><span class="badge bg-secondary"><%= d.current_status %></span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% } %>
