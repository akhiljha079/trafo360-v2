<h4 class="mb-3">Document Issues</h4>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Doc Code</th><th>Document</th><th>Requested By</th><th>Status</th><th>Issue Date</th><th>Due Date</th><th></th></tr></thead>
      <tbody>
      <% issues.forEach(function(i) { %>
        <tr>
          <td><%= i.doc_code %></td>
          <td><%= i.doc_name %></td>
          <td><%= i.requester_name %></td>
          <td><span class="badge status-badge-<%= i.status.replace(/ /g,'') %>"><%= i.status %></span></td>
          <td><%= i.issue_date || '-' %></td>
          <td><%= i.due_date || '-' %></td>
          <td><a href="/issues/<%= i.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }); %>
      <% if (issues.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No issue records found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
