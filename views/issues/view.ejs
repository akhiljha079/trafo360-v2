<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4 class="mb-0">Issue #<%= issue.id %> &mdash; <%= issue.doc_code %></h4>
    <div class="text-muted"><%= issue.doc_name %></div>
  </div>
  <span class="badge status-badge-<%= issue.status.replace(/ /g,'') %> fs-6"><%= issue.status %></span>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header">Request Details</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><th style="width:200px;">Requested By</th><td><%= issue.requester_name %> (<%= issue.requester_email %>)</td></tr>
          <tr><th>Purpose</th><td><%= issue.purpose || '-' %></td></tr>
          <tr><th>Requested Period</th><td><%= issue.requested_days %> day(s)</td></tr>
          <tr><th>Approver</th><td><%= issue.approver_name || '-' %></td></tr>
          <tr><th>Approval Remarks</th><td><%= issue.approval_remarks || '-' %></td></tr>
          <tr><th>Approver Signature</th><td><% if (issue.approver_signature) { %><img src="<%= issue.approver_signature %>" style="height:60px;border:1px solid #E5E9F0;border-radius:4px;"><% } else { %>-<% } %></td></tr>
          <tr><th>Issue Date</th><td><%= issue.issue_date || '-' %></td></tr>
          <tr><th>Due Date</th><td><%= issue.due_date || '-' %></td></tr>
          <tr><th>Return Date</th><td><%= issue.return_date || '-' %></td></tr>
        </table>
      </div>
    </div>

    <% if (issue.status === 'Pending Approval' && currentUser.can_approve_document_issue) { %>
    <div class="card mb-3">
      <div class="card-header">Approve / Reject This Request</div>
      <div class="card-body">
        <form action="/issues/<%= issue.id %>/decision" method="POST" id="decisionForm">
          <div class="mb-2">
            <input type="text" name="remarks" class="form-control" placeholder="Remarks (optional)">
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Signature <span class="text-danger">*</span> <span class="text-muted">(required to approve)</span></label>
            <canvas id="sigPad-<%= issue.id %>" class="sig-pad border rounded" width="400" height="120" style="width:100%;max-width:400px;touch-action:none;background:#fff;"></canvas>
            <div>
              <button type="button" class="btn btn-sm btn-link p-0" onclick="clearSig('sigPad-<%= issue.id %>')">Clear signature</button>
            </div>
            <input type="hidden" name="signature" id="sigInput-<%= issue.id %>">
          </div>
          <div class="d-flex gap-2">
            <button type="submit" name="decision" value="approve" class="btn btn-success flex-fill" onclick="return captureSig('sigPad-<%= issue.id %>','sigInput-<%= issue.id %>', true)">Approve</button>
            <button type="submit" name="decision" value="reject" class="btn btn-danger flex-fill" onclick="return captureSig('sigPad-<%= issue.id %>','sigInput-<%= issue.id %>', false)">Reject</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>

    <% if (['Issued','Overdue','Escalated'].includes(issue.status) && currentUser.can_manage_documents) { %>
    <div class="card mb-3">
      <div class="card-header">Mark as Returned</div>
      <div class="card-body">
        <form action="/issues/<%= issue.id %>/return" method="POST">
          <button type="submit" class="btn btn-success" onclick="return confirm('Confirm this document has been physically returned?')">Mark Returned</button>
        </form>
      </div>
    </div>
    <% } %>

    <% if (['Issued','Overdue'].includes(issue.status) && currentUser.id === issue.requested_by) { %>
    <div class="card mb-3">
      <div class="card-header">Request Extension</div>
      <div class="card-body">
        <form action="/issues/<%= issue.id %>/extend" method="POST" class="row g-2">
          <div class="col-md-4">
            <label class="form-label small">New Due Date</label>
            <input type="date" name="new_due_date" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small">Reason</label>
            <input type="text" name="reason" class="form-control" placeholder="Reason for extension">
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Request</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">Extension Requests</div>
      <div class="card-body">
        <% if (extensions.length === 0) { %><p class="text-muted mb-0">No extension requests.</p><% } %>
        <% extensions.forEach(function(e) { %>
          <div class="border-bottom py-2">
            <div class="d-flex justify-content-between">
              <span>New Due: <b><%= e.requested_new_due_date %></b></span>
              <span class="badge status-badge-<%= e.status %>"><%= e.status %></span>
            </div>
            <div class="small text-muted">Reason: <%= e.reason || '-' %></div>
            <% if (e.status === 'Pending' && currentUser.can_approve_document_issue) { %>
              <form action="/issues/<%= issue.id %>/extend/<%= e.id %>/decision" method="POST" class="mt-2">
                <canvas id="extSig-<%= e.id %>" class="sig-pad border rounded mb-1" width="350" height="90" style="width:100%;max-width:350px;touch-action:none;background:#fff;"></canvas>
                <div><button type="button" class="btn btn-sm btn-link p-0" onclick="clearSig('extSig-<%= e.id %>')">Clear signature</button></div>
                <input type="hidden" name="signature" id="extSigInput-<%= e.id %>">
                <div class="d-flex gap-2 mt-1">
                  <button type="submit" name="decision" value="approve" class="btn btn-sm btn-success flex-fill" onclick="return captureSig('extSig-<%= e.id %>','extSigInput-<%= e.id %>', true)">Approve</button>
                  <button type="submit" name="decision" value="reject" class="btn btn-sm btn-danger flex-fill" onclick="return captureSig('extSig-<%= e.id %>','extSigInput-<%= e.id %>', false)">Reject</button>
                </div>
              </form>
            <% } %>
            <% if (e.approver_signature) { %>
              <div class="small text-muted mt-1">Signed: <img src="<%= e.approver_signature %>" style="height:40px;vertical-align:middle;"></div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script>
  const sigPads = {};
  document.querySelectorAll('canvas.sig-pad').forEach(function(canvas) {
    // Fix canvas resolution to match its displayed size for a crisp signature
    const ratio = Math.max(window.devicePixelRatio || 1, 1);
    canvas.width = canvas.offsetWidth * ratio;
    canvas.height = canvas.offsetHeight * ratio;
    canvas.getContext('2d').scale(ratio, ratio);
    sigPads[canvas.id] = new SignaturePad(canvas, { backgroundColor: '#ffffff', penColor: '#1F4E78' });
  });
  function clearSig(canvasId) {
    if (sigPads[canvasId]) sigPads[canvasId].clear();
  }
  function captureSig(canvasId, inputId, required) {
    const pad = sigPads[canvasId];
    if (required) {
      if (!pad || pad.isEmpty()) {
        alert('Please sign in the box before approving.');
        return false;
      }
    }
    document.getElementById(inputId).value = (pad && !pad.isEmpty()) ? pad.toDataURL('image/png') : '';
    return true;
  }
</script>
