<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-truck"></i> Dispatch Overview</h4>
  <div class="d-flex gap-2">
    <a href="/jobs" class="btn btn-sm btn-outline-secondary">All Jobs</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold badge-phase-Dispatch text-white rounded-3 py-1"><%= inDispatch %></div>
      <div class="text-muted small mt-1">Units in Dispatch</div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold text-success"><%= dispatchedThisMonth %></div>
      <div class="text-muted small">Dispatch Stages Cleared This Month</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">Units Currently in Dispatch</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Job No.</th><th>Customer</th><th>Order / Lot</th><th>Stage</th><th style="width:160px;">Progress</th><th>Target Dispatch</th><th></th></tr></thead>
      <tbody>
      <% jobs.forEach(function(j) { %>
        <tr>
          <td><%= j.job_no %></td>
          <td><%= j.customer_name %></td>
          <td class="small"><%= j.order_no || '-' %><% if (j.lot_name) { %> / <%= j.lot_name %><% } %></td>
          <td><span class="badge badge-phase-<%= j.phase %>"><%= j.stage_code %></span> <span class="small"><%= j.stage_name %></span></td>
          <td>
            <div class="progress-track"><div class="progress-fill" style="width:<%= j.progressPct %>%;"></div></div>
            <div class="small text-muted"><%= j.progressPct %>%</div>
          </td>
          <td><span class="badge badge-rag-<%= j.rag %>"><%= j.target_dispatch_date || 'No target' %></span></td>
          <td><a href="/jobs/<%= j.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }); %>
      <% if (!jobs.length) { %><tr><td colspan="7" class="text-center text-muted py-4">No units currently in Dispatch.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
