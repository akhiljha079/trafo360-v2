<%- include('_topbar') %>

<h4 class="mb-3">My Orders</h4>

<div class="entity-card-grid">
  <% orders.forEach(function(o, i) { %>
    <% var pct = o.unit_count ? Math.round((o.completed_units / o.unit_count) * 100) : 0; %>
    <a href="/portal/orders/<%= o.id %>" class="entity-card" data-animate style="transition-delay: <%= Math.min(i, 10) * 30 %>ms;">
      <div class="entity-card-header">
        <div>
          <div class="entity-card-title"><%= o.order_no %></div>
          <div class="entity-card-meta"><%= o.transformer_type %></div>
        </div>
        <span class="badge bg-secondary"><%= o.status %></span>
      </div>
      <div class="entity-card-meta">Qty <%= o.total_quantity %> &middot; PO <%= o.po_no || 'N/A' %></div>
      <div class="mt-1">
        <div class="progress-track"><div class="progress-fill" style="width:<%= pct %>%;"></div></div>
        <div class="small text-muted"><%= o.completed_units %> / <%= o.unit_count %> units completed</div>
      </div>
    </a>
  <% }); %>
  <% if (orders.length === 0) { %><p class="text-muted text-center py-5">No orders linked to your account yet.</p><% } %>
</div>
