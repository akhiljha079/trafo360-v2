<%- include('_topbar') %>

<div class="mb-3">
  <a href="/portal" class="small text-decoration-none">&larr; My Orders</a>
  <h4 class="mb-0"><%= order.order_no %></h4>
  <div class="text-muted small"><%= order.transformer_type %> &middot; <%= order.rating || 'N/A' %> &middot; Qty <%= order.total_quantity %> &middot; <span class="badge bg-secondary"><%= order.status %></span></div>
</div>

<div class="card mb-3">
  <div class="card-header">Unit Progress</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Unit</th><th>Serial No.</th><th>Current Stage</th><th style="width:160px;">Progress</th><th>Status</th></tr></thead>
      <tbody>
      <% units.forEach(function(u) { %>
        <tr>
          <td><%= u.lot_name || '-' %><% if (u.unit_no) { %> #<%= u.unit_no %><% } %></td>
          <td class="small"><%= u.serial_no || '-' %></td>
          <td><% if (u.stage_name) { %><span class="badge badge-phase-<%= u.phase %>"><%= u.stage_name %></span><% } else { %>Not started<% } %></td>
          <td>
            <div class="progress-track"><div class="progress-fill" style="width:<%= u.progressPct %>%;"></div></div>
            <div class="small text-muted"><%= u.progressPct %>%</div>
          </td>
          <td><span class="badge badge-rag-<%= u.rag %>"><%= u.status %></span></td>
        </tr>
      <% }); %>
      <% if (units.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No units yet for this order.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header">Documents</div>
  <div class="card-body">
    <% documents.forEach(function(d) { %>
      <div class="d-flex justify-content-between border-bottom py-2">
        <div>
          <div class="fw-bold"><%= d.doc_code %></div>
          <div class="small text-muted"><%= d.doc_name %> &middot; <%= d.category_name || 'Uncategorized' %></div>
        </div>
        <a href="/portal/documents/<%= d.id %>/download" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i> Download</a>
      </div>
    <% }); %>
    <% if (documents.length === 0) { %><p class="text-muted mb-0">No documents released for this order yet.</p><% } %>
  </div>
</div>
