<div class="login-wrapper">
  <div class="login-visual d-none d-md-flex">
    <span class="badge-est">Customer Portal</span>
    <h1>Track Your Transformer<br>Order, Start to Finish.</h1>
    <p>See your unit's manufacturing progress and download the reports and certificates <%= typeof appName !== 'undefined' ? appName : 'TRAFO 360' %> has released for your order.</p>
  </div>

  <div class="login-form-side">
    <div class="login-card">
      <div class="text-center mb-3">
        <div class="login-title">Customer Portal</div>
        <p class="text-muted small mb-0">Sign in to track your order</p>
      </div>
      <form action="/portal/login" method="POST">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign In</button>
      </form>
      <p class="text-muted small text-center mt-3 mb-0">Don't have a login? Contact your Trafo Power &amp; Electricals representative.</p>
      <p class="text-center small mt-3 mb-0"><a href="/login">Staff login &rarr;</a></p>
    </div>
  </div>
</div>
