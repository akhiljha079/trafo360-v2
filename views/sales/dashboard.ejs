<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="mb-0"><i class="bi bi-graph-up-arrow"></i> Sales Overview</h4>
  <div class="d-flex gap-2">
    <a href="/orders/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> New Order</a>
    <a href="/orders" class="btn btn-sm btn-outline-secondary">All Orders</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold text-primary"><%= activeOrders %></div>
      <div class="text-muted small">Active Orders</div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold text-warning"><%= awaitingLots %></div>
      <div class="text-muted small">Orders Awaiting First Lot</div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card p-3 text-center" data-animate>
      <div class="fs-4 fw-bold"><%= totalUnits %></div>
      <div class="text-muted small">Units Across All Orders</div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="card p-3" data-animate>
      <div class="text-muted small mb-1">Orders by Status</div>
      <% ordersByStatus.forEach(function(s) { %>
        <div class="d-flex justify-content-between small"><span><%= s.status %></span><strong><%= s.cnt %></strong></div>
      <% }); %>
      <% if (!ordersByStatus.length) { %><span class="text-muted small">No orders yet.</span><% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">Recent Orders</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Order No.</th><th>Customer</th><th>Type</th><th>Qty</th><th>Lots</th><th>Units</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% recentOrders.forEach(function(o) { %>
        <tr>
          <td><%= o.order_no %></td>
          <td><%= o.customer_name %></td>
          <td class="small"><%= o.transformer_type %></td>
          <td><%= o.total_quantity %></td>
          <td><%= o.lot_count %></td>
          <td><%= o.unit_count %></td>
          <td><span class="badge bg-secondary"><%= o.status %></span></td>
          <td><a href="/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }); %>
      <% if (!recentOrders.length) { %><tr><td colspan="8" class="text-center text-muted py-4">No orders yet - create the first one.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
