# Example reverse-proxy config for TRAFO 360. Copy to your nginx sites and
# adjust server_name / certificate paths. See docs/deployment.md for the
# full DNS/TLS/firewall walkthrough.

server {
    listen 80;
    server_name document.company.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name document.company.com;

    ssl_certificate     /etc/letsencrypt/live/document.company.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/document.company.com/privkey.pem;

    client_max_body_size 200m;  # large CAD/drawing uploads (spec §19)

    location /api/ {
        proxy_pass http://api:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web:80/;
        proxy_set_header Host $host;
    }
}
